{
  "name": "halifax-income-map",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/prepare-web-data.mjs",
    "dev": "npm run prepare:data && vite --host 127.0.0.1",
    "build": "npm run prepare:data && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "measure": "node scripts/measure-mobile.mjs",
    "audit:release": "node scripts/release-tools.mjs audit",
    "check:release": "node scripts/release-tools.mjs check",
    "test:browsers": "CROSS_BROWSER=1 playwright test",
    "test:release": "node --test tests/release.test.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
